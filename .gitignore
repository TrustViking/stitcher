########################################
# Stitcher: privacy + clean repo
########################################

########################################
# Secrets / credentials (НЕ КОМИТИТЬ)
########################################
secrets/*
!secrets/README.txt

# Google OAuth / API
credentials*.json
client_secret*.json
*oauth*.json
*service_account*.json
*service-account*.json

# Keys / certs
*.pem
*.key
*.p12

########################################
# Local config (личный sheets_id и т.п.)
########################################
config.toml
!config.example.toml

########################################
# Python / caches
########################################
__pycache__/
*.py[cod]
*.pyd
*.so

.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
pip-wheel-metadata/
*.egg-info/
.eggs/
build/
dist/

########################################
# Virtual environments
########################################
.venv/
venv/
ENV/
.venv_*/
.venv-*/

########################################
# Logs / temp / outputs (runtime артефакты)
########################################
*.log
logs/
tmp/
temp/
out/
output/
outputs/
downloads/
state/
tools/

########################################
# IDE / OS
########################################
.vscode/
_HELP/
*.code-workspace
Thumbs.db
Desktop.ini
.DS_Store

########################################
# Local launcher scripts (личные пути)
########################################
*.local.bat
run_local*.bat
